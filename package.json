{
  "name": "fieldstone-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3200",
    "lint": "next lint",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx --test scripts/security.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "tsx": "^4.23.0"
  },
  "overrides": {
    "postcss": "8.5.31",
    "zod": "4.6.7"
  }
